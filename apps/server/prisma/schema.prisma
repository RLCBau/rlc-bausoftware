enum WorkflowStatus {
  DRAFT
  EINGEREICHT
  FREIGEGEBEN
  ABGELEHNT
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  companyId String?
  ip        String?
  action    String
  resource  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([companyId])
  @@index([createdAt])
}

model KalkulationsDbEntry {
  id          String  @id @default(uuid())
  companyId   String
  projectId   String?
  source      String  @default("ki")
  projectCode String?
  projectName String?

  priceDate       DateTime?
  priceDateSource String?

  positionNumber String?
  shortText      String
  longText       String?
  unit           String?
  quantity       Float   @default(0)

  materialCost      Float @default(0)
  laborCost         Float @default(0)
  machineCost       Float @default(0)
  subcontractorCost Float @default(0)
  disposalCost      Float @default(0)
  transportCost     Float @default(0)
  overheadCost      Float @default(0)
  riskCost          Float @default(0)
  profitCost        Float @default(0)

  unitPriceNet Float @default(0)
  totalNet     Float @default(0)

  trade              String?
  serviceType        String?
  constructionMethod String?
  soilClass          String?

