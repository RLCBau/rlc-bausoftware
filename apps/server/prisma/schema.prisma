generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  contactInsurancePolicies PartyInsurancePolicy[]
  catalogAssignments CompanyCatalogAssignment[]

  masterCatalog CompanyMasterCatalog[]
 projectShipments ProjectShipment[]
  machineUsageEntries MachineUsageEntry[]
  machineReleases MachineRelease[]
  procurementBids ProjectBid[]
  guarantees ProjectGuarantee[]
  contractCertificates ContractCertificate[]
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  address   String?

  // Company Header / Letterhead
  phone    String?
  email    String?
  logoPath String? // e.g. "companies/<companyId>/logo.png"

  updatedAt             DateTime              @updatedAt
  activities            ActivityLog[]
  companyPrices         CompanyPrice[]
  companyProductivities CompanyProductivity[]
  parties               Party[]
  projects              Project[]
  contracts             Contract[]
  communicationThreads  CommunicationThread[]
  projectTasks          ProjectTask[]
  projectNotes          ProjectNote[]
  users                 User[]

  // Subscription (1:1 optional)
  subscription CompanySubscription?

  // Invites + Members (seat & invite system)
  invites              CompanyInvite[]
  members              CompanyMember[]
  mobileLicenses       MobileLicense[]
  submissions          ProjectSubmission[]
  calendarEvents       OfficeCalendarEvent[]
  aiMarketReviewUsage   AiMarketReviewUsage[]
  aiMarketCreditOrders  AiMarketCreditOrder[]
  aiMarketReviewCaches  AiMarketReviewCache[]
  deliveryReviews DeliveryReview[]

}

model AiMarketReviewUsage {
  id               String   @id @default(cuid())
  companyId        String
  userId           String?
  projectId        String?
  positionId       String?
  provider         String
  model            String
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  totalTokens      Int      @default(0)
  webSearchCalls   Int      @default(0)
  creditsUsed      Int      @default(1)
  creditSource     String?
  estimatedCostUsd Decimal  @default(0) @db.Decimal(12, 6)
  status           String   @default("SUCCESS")
  createdAt        DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([companyId, model, createdAt])
  @@index([projectId, createdAt])
}

model AiMarketReviewCache {
  id          String   @id @default(cuid())
  companyId   String
  fingerprint String
  marketMonth String
  result      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, fingerprint, marketMonth])
  @@index([companyId, marketMonth])
}

model AiMarketCreditOrder {
  id         String    @id @default(cuid())
  companyId  String
  userId     String?
  credits    Int
  priceCents Int
  status     String    @default("PENDING")
  note       String?
  createdAt  DateTime  @default(now())
  paidAt     DateTime?
  creditedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status, createdAt])
  @@index([createdAt])
}

model VorlageTemplate {
  id               String   @id @default(cuid())
  slug             String   @unique
  companyId        String?
  sourceTemplateId String?
  title            String
  description      String
  categoryKey      String
  categoryLabel    String
  language         String   @default("de")
  outputType       String   @default("DOCUMENT")
  content          Json
  variables        Json
  tags             String[]
  isStandard       Boolean  @default(false)
  isProtected      Boolean  @default(false)
  isActive         Boolean  @default(true)
  version          Int      @default(1)
  usageCount       Int      @default(0)
  createdByUserId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sourceTemplate VorlageTemplate?  @relation("VorlageCopies", fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  copies         VorlageTemplate[] @relation("VorlageCopies")
  favorites      VorlageFavorite[]
  documents      VorlageDocument[]

  @@index([companyId, categoryKey, isActive])
  @@index([isStandard, isActive])
  @@index([title])
}

model VorlageFavorite {
  id         String   @id @default(cuid())
  companyId  String
  userId     String
  templateId String
  createdAt  DateTime @default(now())

  template VorlageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId, templateId])
  @@index([companyId, userId])
}

model VorlageDocument {
  id              String   @id @default(cuid())
  companyId       String
  projectId       String?
  templateId      String?
  title           String
  content         Json
  values          Json
  status          String   @default("ENTWURF")
  outputFormat    String   @default("DOCUMENT")
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  template VorlageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([companyId, projectId, updatedAt])
  @@index([templateId])
}

model CompanyInvite {
  id        String      @id @default(uuid())
  companyId String
  email     String?
  role      ProjectRole @default(MITARBEITER)

  // codice che l'admin consegna all'utente
  code String @unique

  // opzionale, utile se in futuro vuoi anche link invito sicuri via email
  tokenHash String? @unique

  maxUses   Int     @default(1)
  usedCount Int     @default(0)
  isActive  Boolean @default(true)

  expiresAt         DateTime
  acceptedAt        DateTime?
  createdAt         DateTime  @default(now())
  createdByUserId   String?
  activatedByUserId String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([email])
  @@index([code])
  @@index([companyId, isActive])
}

model MobileLicense {
  id        String @id @default(uuid())
  companyId String
  code      String @unique
  role      String
  status    String @default("FREE")

  employeeName  String?
  employeeEmail String?
  deviceName    String?
  deviceId      String?
  appVersion    String?

  activatedAt DateTime?
  lastLoginAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdByUserId String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, role])
  @@index([deviceId])
}

model CompanyMember {
  id        String      @id @default(uuid())
  companyId String
  userId    String
  role      ProjectRole @default(MITARBEITER)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId], name: "companyId_userId")
  @@index([companyId, active])
  @@index([userId])
}

model CompanySubscription {
  id        String             @id @default(uuid())
  companyId String             @unique
  status    SubscriptionStatus @default(ACTIVE)
  plan      SubscriptionPlan   @default(MAX_UNLIMITED)

  // limite legacy / generico
  seatsLimit Int?

  // nuove licenze esplicite per RLC
  webSeatsPurchased    Int     @default(0)
  mobileSeatsPurchased Int     @default(0)
  cloudEnabled         Boolean @default(false)

  // KI-Marktpreisprüfung: 50 Monatsprüfungen + zukaufbare Firmenkontingente
  aiMarketMonthlyIncluded  Int     @default(50)
  aiMarketMonthlyUsed      Int     @default(0)
  aiMarketMonthKey         String?
  aiMarketCreditsPurchased Int     @default(0)

  currentPeriodStart         DateTime  @default(now())
  currentPeriodEnd           DateTime?
  appleLatestTransactionId   String?
  appleOriginalTransactionId String?
  lastVerifiedAt             DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status, plan])
}

enum SubscriptionStatus {
  ACTIVE
  GRACE
  EXPIRED
}

enum SubscriptionPlan {
  BASIC_5
  PRO_20
  MAX_UNLIMITED
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  password          String
  createdAt         DateTime  @default(now())
  companyId         String?
  role              UserRole  @default(user)
  currentProjectId  String?
  appRole           String?
  emailVerifiedAt   DateTime?
  name              String?
  verifyTokenExpiry DateTime?
  verifyTokenHash   String?
  resetTokenExpiry  DateTime?
  resetTokenHash    String?

  activities     ActivityLog[]
  projectMembers ProjectMember[]
  companyMembers CompanyMember[]
  submissions    ProjectSubmission[]

  company        Company? @relation(fields: [companyId], references: [id])
  currentProject Project? @relation("UserCurrentProject", fields: [currentProjectId], references: [id])
}

model Project {
 projectShipments ProjectShipment[]
  machineUsageEntries MachineUsageEntry[]
  machineReleases MachineRelease[]
  procurementBids ProjectBid[]
  guarantees ProjectGuarantee[]
  contractCertificates ContractCertificate[]
  id          String    @id @default(uuid())
  name        String
  code        String
  companyId   String
  createdAt   DateTime  @default(now())
  description String?
  endDate     DateTime?
  startDate   DateTime?
  updatedAt   DateTime  @updatedAt
  number      String?
  path        String?
  slug        String?   @unique
  status      String    @default("active")
  client      String?
  place       String?

  accounting           AccountingRoot?
  activities           ActivityLog[]
  deliveryNotes        DeliveryNote[]
  documents            Document[]
  contracts            Contract[]
  communicationThreads CommunicationThread[]
  projectTasks         ProjectTask[]
  projectNotes         ProjectNote[]
  lvSets               LVHeader[]
  lvItems              LVItem[]
  measSets             MeasurementSet[]
  offerVersions        OfferVersion[]
  planSnapshots        PlanSnapshot[]
  planTasks            PlanTask[]

  company            Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  files              ProjectFile[]
  projectMembers     ProjectMember[]
  sectionStates      ProjectSectionState[]
  regieReports       RegieReport[]
  resourceCapacities ResourceCapacity[]
  currentUsers       User[]                @relation("UserCurrentProject")
  workflowDocs       WorkflowDoc[]
  aufmassOrte        AufmassOrt[]
  submissions        ProjectSubmission[]
  calendarEvents     OfficeCalendarEvent[]

  @@unique([code, companyId])
  deliveryReviews DeliveryReview[]

}

model ProjectFile {
  id        String   @id @default(cuid())
  projectId String
  relPath   String
  kind      String
  size      Int
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model LVItem {
  id             String   @id @default(cuid())
  quantity       Float?   @default(0)
  unit           String?
  unitPrice      Float?
  calcResult     Float?
  createdAt      DateTime @default(now())
  projectId      String
  calcExpression String?
  calcVariables  String?
  longText       String?
  positionNumber String?
  shortText      String?
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([positionNumber])
}

model RegieReport {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  projectId String
  date      DateTime @default(now())
  hours     Float?
  note      String?
  quantity  Float?
  typ       RegieTyp
  unit      String?
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, date])
}

model DeliveryNote {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  projectId String
  material  String?
  note      String?
  qty       Float?
  raw       Json?
  unit      String?
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, date])
}

model OfferVersion {
  id        Int      @id @default(autoincrement())
  projectId String
  filename  String
  positions Json
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model PlanTask {
  id        String    @id @default(cuid())
  projectId String
  name      String
  dauerTage Int
  start     DateTime?
  end       DateTime?
  progress  Int       @default(0)
  notes     String?
  assignee  String?
  milestone Boolean   @default(false)
  depsJson  String
  ressJson  String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ResourceAssignment {
  id           String   @id @default(uuid())
  companyId    String
  resourceType String
  resourceId   String
  date         DateTime
  projectId    String?
  hours        Float    @default(8)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId, date])
  @@index([companyId, resourceType, resourceId, date])
  @@index([companyId, projectId, date])
}

model ResourceCapacity {
  id        String  @id @default(cuid())
  projectId String
  name      String
  capacity  Float
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
}

model PlanSnapshot {
  id        String   @id @default(cuid())
  projectId String
  start     DateTime
  ende      DateTime
  json      Json
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, start])
}

model ProjectMember {
  id          String      @id @default(uuid())
  projectId   String
  userId      String
  role        ProjectRole
  canDownload Boolean     @default(false)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId, role])
}

model StorageObject {
  id               String                   @id
  bucket           String
  key              String
  size             BigInt
  sha256           String
  mime             String
  createdAt        DateTime                 @default(now())
  versions         FileVersion[]
  employeeDocument CompanyEmployeeDocument?

  safetyInstructionDocument SafetyInstructionDocument?
  safetyAttachment          SafetyAttachment?
  handoverAttachment        CompanyHandoverAttachment?
  machineAttachment         CompanyMachineAttachment?
  materialAttachment        CompanyMaterialAttachment?

  @@index([bucket, key])
}

model Document {
 shipments ProjectShipment[] @relation("ShipmentDocument")
 shipmentReceipts ProjectShipment[] @relation("ShipmentReceipt")
  machineUsageEntries MachineUsageEntry[]
  machineReleases MachineRelease[]
  procurementBids ProjectBid[]
  guarantees ProjectGuarantee[]
  contractCertificates ContractCertificate[]
  id                      String                   @id @default(uuid())
  projectId               String
  kind                    FileKind
  name                    String
  meta                    Json?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  deletedAt               DateTime?
  currentVid              String?                  @unique
  current                 FileVersion?             @relation("CurrentVersion", fields: [currentVid], references: [id])
  project                 Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions                FileVersion[]
  invoicePdfs             Invoice[]                @relation("InvoicePdf")
  vendorBillPdfs          VendorBill[]             @relation("VendorBillPdf")
  workflowLinks           WorkflowDocLink[]
  contract                Contract?
  communicationAttachment CommunicationAttachment?

  @@index([projectId, kind, createdAt])
}

model Contract {
  guarantees ProjectGuarantee[]
  contractCertificates ContractCertificate[]
  id               String  @id @default(uuid())
  companyId        String
  projectId        String
  documentId       String? @unique
  parentContractId String?

  title          String
  contractNumber String?
  partner        String?
  contractType   String  @default("Bauvertrag")
  status         String  @default("Entwurf")

  valueNet         Float     @default(0)
  startDate        DateTime?
  endDate          DateTime?
  cancellationDays Int       @default(30)

  notes String?
  tags  String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document       Document?  @relation(fields: [documentId], references: [id], onDelete: SetNull)
  parentContract Contract?  @relation("ContractHierarchy", fields: [parentContractId], references: [id], onDelete: SetNull)
  subcontracts   Contract[] @relation("ContractHierarchy")

  @@index([companyId, projectId])
  @@index([companyId, status])
  @@index([projectId, endDate])
  @@index([parentContractId])
  @@index([documentId])
}

model CommunicationThread {
  id           String   @id @default(uuid())
  companyId    String
  projectId    String
  subject      String   @default("")
  participants String[]
  unreadCount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company     Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project     Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages    CommunicationMessage[]
  attachments CommunicationAttachment[]

  @@index([companyId, projectId, updatedAt])
}

model CommunicationMessage {
  id        String   @id @default(uuid())
  threadId  String
  fromName  String
  toList    String[]
  ccList    String[]
  subject   String?
  body      String
  createdAt DateTime @default(now())

  thread CommunicationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model CommunicationAttachment {
  id         String   @id @default(uuid())
  threadId   String
  documentId String?  @unique
  name       String
  createdAt  DateTime @default(now())

  thread   CommunicationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  document Document?           @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
}

model ProjectTask {
  id          String    @id @default(uuid())
  companyId   String
  projectId   String
  title       String
  due         DateTime?
  done        Boolean   @default(false)
  assignee    String?
  priority    String    @default("med")
  tags        String[]
  description String?
  sourceType  String?
  sourceId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId, projectId, done])
  @@index([projectId, due])
}

model ProjectNote {
  id        String   @id @default(uuid())
  companyId String
  projectId String
  text      String
  tags      String[]
  author    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId, projectId, updatedAt])
}

model OfficeCalendarEvent {
  id              String   @id @default(uuid())
  companyId       String
  projectId       String?
  title           String
  start           DateTime
  end             DateTime
  allDay          Boolean  @default(false)
  location        String?
  attendees       String[]
  notes           String?
  category        String?
  busyStatus      String   @default("busy")
  reminderMinutes Int?     @default(15)
  source          String   @default("RLC")
  externalId      String?
  sourceType      String?
  sourceId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([companyId, start, end])
  @@index([projectId, start])
  @@index([companyId, externalId])
}

model FileVersion {
  id         String        @id @default(uuid())
  documentId String
  storageId  String
  version    Int
  uploadedBy String?
  createdAt  DateTime      @default(now())
  currentOf  Document?     @relation("CurrentVersion")
  document   Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  storage    StorageObject @relation(fields: [storageId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId, createdAt])
}

model LVHeader {
  id        String @id @default(uuid())
  projectId String
  title     String
  version   Int    @default(1)
  currency  String @default("EUR")

  priceDate       DateTime?
  priceDateSource String?

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  positions LVPosition[]

  @@unique([projectId, version])
  @@index([projectId])
  @@index([priceDate])
}

model LVPosition {
  id              String           @id @default(uuid())
  lvId            String
  position        String
  kurztext        String
  langtext        String?
  einheit         String
  menge           Decimal          @db.Decimal(18, 6)
  einzelpreis     Decimal?         @db.Decimal(18, 4)
  gesamt          Decimal?         @db.Decimal(18, 2)
  x84UnitPrice    Decimal?         @db.Decimal(18, 4)
  x84Total        Decimal?         @db.Decimal(18, 2)
  parentPos       String?
  gaebAlnGroupNo  Int?
  gaebAlnSerNo    Int?
  gaebProvis      String?
  gaebProvisAccpt String?
  gaebAccepted    String?
  lv              LVHeader         @relation(fields: [lvId], references: [id], onDelete: Cascade)
  measurements    MeasurementRow[] @relation("LVPos_Measurements")

  @@index([lvId, position])
}

model MeasurementSet {
  id        String           @id @default(uuid())
  projectId String
  title     String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  rows      MeasurementRow[]
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model MeasurementRow {
  id           String            @id @default(uuid())
  setId        String
  lvPositionId String?
  source       MeasurementSource
  formula      String?
  quantity     Decimal           @db.Decimal(18, 6)
  unit         String
  context      Json?
  createdAt    DateTime          @default(now())
  lvPosition   LVPosition?       @relation("LVPos_Measurements", fields: [lvPositionId], references: [id])
  set          MeasurementSet    @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@index([setId])
  @@index([lvPositionId])
}

model ProjectSectionState {
  id        String   @id @default(uuid())
  projectId String
  section   Section
  data      Json
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, section], name: "projectId_section")
  @@index([projectId])
}

model Party {
  insurancePolicies PartyInsurancePolicy[]
  supplierCertificates ContractCertificate[]
  contactProfile PartyContactProfile?
  id                    String       @id @default(uuid())
  companyId             String
  type                  PartyType
  name                  String
  vatId                 String?
  email                 String?
  phone                 String?
  address               Json?
  invoicesAsCustomer    Invoice[]
  company               Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendorBillsAsSupplier VendorBill[]

  @@index([companyId, type, name])
}

model AccountingRoot {
  id          String        @id @default(uuid())
  projectId   String        @unique
  currency    String        @default("EUR")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoices    Invoice[]
  ledger      LedgerEntry[]
  recurringTemplates RecurringLedgerTemplate[]
  payments    Payment[]
  vendorBills VendorBill[]
}

model TaxRate {
  id        String    @id @default(uuid())
  name      String
  rate      Decimal   @db.Decimal(5, 2)
  validFrom DateTime
  validTo   DateTime?
}

model Invoice {
  id           String         @id @default(uuid())
  accountingId String
  number       String
  date         DateTime
  customerId   String
  netAmount    Decimal        @db.Decimal(18, 2)
  taxAmount    Decimal        @db.Decimal(18, 2)
  grossAmount  Decimal        @db.Decimal(18, 2)
  status       String         @default("open")
  data         Json?
  pdfDocId     String?
  accounting   AccountingRoot @relation(fields: [accountingId], references: [id], onDelete: Cascade)
  customer     Party          @relation(fields: [customerId], references: [id])
  pdfDoc       Document?      @relation("InvoicePdf", fields: [pdfDocId], references: [id])

  @@unique([accountingId, number])
  @@index([date, status])
  @@index([customerId])
  @@index([pdfDocId])
}

model VendorBill {
  id           String         @id @default(uuid())
  accountingId String
  number       String
  date         DateTime
  supplierId   String
  netAmount    Decimal        @db.Decimal(18, 2)
  taxAmount    Decimal        @db.Decimal(18, 2)
  grossAmount  Decimal        @db.Decimal(18, 2)
  status       String         @default("open")
  data         Json?
  pdfDocId     String?
  accounting   AccountingRoot @relation(fields: [accountingId], references: [id], onDelete: Cascade)
  pdfDoc       Document?      @relation("VendorBillPdf", fields: [pdfDocId], references: [id])
  supplier     Party          @relation(fields: [supplierId], references: [id])

  @@unique([accountingId, number])
  @@index([date, status])
  @@index([supplierId])
  @@index([pdfDocId])
}

model Payment {
  id           String         @id @default(uuid())
  accountingId String
  date         DateTime
  amount       Decimal        @db.Decimal(18, 2)
  method       String
  direction    String
  refType      String?
  refId        String?
  data         Json?
  accounting   AccountingRoot @relation(fields: [accountingId], references: [id], onDelete: Cascade)

  @@index([accountingId, date])
}

model LedgerEntry {
  id            String         @id @default(uuid())
  accountingId  String
  date          DateTime
  account       String
  contraAccount String
  amount        Decimal        @db.Decimal(18, 2)
  text          String?
  refType       String?
  refId         String?
  accounting    AccountingRoot @relation(fields: [accountingId], references: [id], onDelete: Cascade)

  @@index([accountingId, date, account])
  costCenter String?
  recurringOccurrence RecurringLedgerOccurrence?

}

model ProjectSubmission {
  id        String  @id @default(uuid())
  companyId String
  projectId String
  userId    String?

  source   SubmissionSource
  kind     String
  entityId String?
  title    String?
  meta     Json?

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, projectId, createdAt])
  @@index([companyId, projectId, userId, createdAt])
  @@index([projectId, source, createdAt])
  @@index([userId, createdAt])
  @@index([kind])
}

model ActivityLog {
  id        String   @id @default(uuid())
  companyId String
  projectId String?
  userId    String?
  action    String
  meta      Json?
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@index([companyId, projectId, createdAt])
}

model RecipeTemplate {
  id                    String                @id @default(cuid())
  key                   String                @unique
  title                 String
  category              String
  unit                  String
  description           String?
  paramsJson            Json?
  tags                  String[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  companyProductivities CompanyProductivity[]
  components            RecipeComponent[]
  variants              RecipeVariant[]
}

model RecipeComponent {
  id         String              @id @default(cuid())
  templateId String
  type       RecipeComponentType
  refKey     String
  qtyFormula String
  mandatory  Boolean             @default(true)
  riskFactor Decimal             @default(1.0) @db.Decimal(10, 4)
  sort       Int                 @default(0)
  note       String?
  template   RecipeTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, type])
  @@index([refKey])
}

model RecipeVariant {
  id                    String                @id @default(cuid())
  templateId            String
  key                   String                @unique
  unit                  String
  params                Json
  enabled               Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  companyProductivities CompanyProductivity[]
  template              RecipeTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, enabled])
}

model CompanyPrice {
  id        String    @id @default(cuid())
  companyId String
  refKey    String
  price     Decimal   @db.Decimal(18, 6)
  unit      String
  validFrom DateTime  @default(now())
  validTo   DateTime?
  note      String?
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, refKey, validFrom])
  @@index([companyId, refKey])
}

model CompanyProductivity {
  id         String         @id @default(cuid())
  companyId  String
  templateId String
  variantId  String?
  value      Decimal        @db.Decimal(18, 6)
  unit       String
  source     String
  confidence Int            @default(70)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template   RecipeTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  variant    RecipeVariant? @relation(fields: [variantId], references: [id])

  @@index([companyId, templateId])
  @@index([companyId, variantId])
}

model WorkflowDoc {
  id             String            @id @default(uuid())
  projectId      String
  type           WorkflowDocType
  status         WorkflowStatus    @default(EINGEREICHT)
  fsKey          String
  fsPath         String
  docId          String
  date           DateTime?
  title          String?
  searchText     String?
  fileCount      Int               @default(0)
  submittedAt    DateTime?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  approvedBy     String?
  rejectedReason String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  links          WorkflowDocLink[]

  @@unique([projectId, type, docId])
  @@index([projectId, type, status, createdAt])
  @@index([projectId, date])
}

model WorkflowDocLink {
  id            String      @id @default(uuid())
  workflowDocId String
  documentId    String
  kind          FileKind
  note          String?
  document      Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  workflowDoc   WorkflowDoc @relation(fields: [workflowDocId], references: [id], onDelete: Cascade)

  @@index([workflowDocId])
  @@index([documentId])
}

