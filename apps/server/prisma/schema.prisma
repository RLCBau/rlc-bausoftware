model CompanyRecipeDb {
  id          String  @id @default(uuid())
  companyId   String
  projectId   String?
  signature   String
  title       String
  sourcePosNr String?
  sourceText  String?
  unit        String?
  context     Json?
  lines       Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, signature], name: "companyId_signature")
  @@index([companyId])
  @@index([projectId])
  @@index([signature])
}

model RlcGlobalPriceKnowledge {
  id String @id @default(uuid())

  normalizedKey String @unique

  positionNumber String?
  shortText      String
  unit           String?

  trade              String?
  serviceType        String?
  constructionMethod String?
  soilClass          String?

  minPrice    Float @default(0)
  avgPrice    Float @default(0)
  maxPrice    Float @default(0)
  medianPrice Float @default(0)

  sampleCount        Int @default(0)
  sourceCompanyCount Int @default(0)

  country   String?
  region    String?
  priceYear Int?

  confidence Float @default(0.75)

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([normalizedKey])
  @@index([shortText])
  @@index([unit])
  @@index([trade])
  @@index([serviceType])
  @@index([constructionMethod])
}

model RlcGlobalPosition {
  id String @id @default(uuid())

  source     String?
  sourceUrl  String?
  sourceType String?
  region     String?
  year       Int?

  gewerk         String?
  category       String?
  positionNumber String?
  shortText      String
  longText       String?
  unit           String?

  priceMin Float?
  priceAvg Float?
  priceMax Float?

  confidence  Float @default(0.3)
  sampleCount Int   @default(1)

  isContextSensitive Boolean @default(false)
  needsReview        Boolean @default(true)

  normalizedKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shortText])
  @@index([unit])
  @@index([gewerk])
  @@index([category])
  @@index([normalizedKey])
}

model RlcGlobalImportLog {
  id String @id @default(uuid())

  sourceName String
  sourceType String?
  sourceUrl  String?

  importedRows Int @default(0)
  acceptedRows Int @default(0)
  rejectedRows Int @default(0)

  notes String?

  createdAt DateTime @default(now())
}

model RlcGlobalKnowledgeAggregated {
  id String @id @default(uuid())

  normalizedKey String  @unique
  shortText     String
  longText      String?
  unit          String?

  gewerk   String?
  category String?

  priceMin Float?
  priceAvg Float?
  priceMax Float?

  confidence  Float @default(0.3)
  sampleCount Int   @default(0)

  sources            Json?
  isContextSensitive Boolean @default(false)
  needsReview        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shortText])
  @@index([unit])
  @@index([gewerk])
  @@index([category])
  @@index([confidence])
}

model AufmassOrt {
  id          String   @id @default(uuid())
  projectId   String
  parentId    String?
  nummer      String
  name        String
  description String?
  color       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    AufmassOrt?          @relation("AufmassOrtTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  AufmassOrt[]         @relation("AufmassOrtTree")
  positions AufmassOrtPosition[]

  @@index([projectId])
  @@index([projectId, parentId])
  @@index([projectId, sortOrder])
}

model AufmassOrtPosition {
  ortId      String
  positionId String
  createdAt  DateTime @default(now())

  ort AufmassOrt @relation(fields: [ortId], references: [id], onDelete: Cascade)

  @@id([ortId, positionId])
  @@index([positionId])
}

model MarketIntelligenceEvent {
  id             String                        @id @default(uuid())
  externalId     String                        @unique
  title          String
  url            String?
  sourceId       String
  sourceName     String
  publishedAt    DateTime
  priority       String
  relevanceScore Int
  trustScore     Int
  totalScore     Int
  verification   String
  matchedSignals Json
  priceHints     Json
  marketImpact   Json
  candidates     MarketIntelligenceCandidate[]
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  @@index([publishedAt])
  @@index([totalScore])
}

model MarketIntelligenceCandidate {
  id            String                     @id @default(uuid())
  eventId       String
  type          String
  status        String                     @default("NEW")
  title         String
  rationale     String?
  confidence    Float                      @default(0.5)
  proposedData  Json
  reviewedAt    DateTime?
  reviewedBy    String?
  reviewNote    String?
  appliedAt     DateTime?
  appliedBy     String?
  appliedResult Json?
  event         MarketIntelligenceEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reviews       MarketIntelligenceReview[]
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@index([eventId])
  @@index([status, type])
}

model MarketIntelligenceReview {
  id          String                      @id @default(uuid())
  candidateId String
  action      String
  note        String?
  userId      String?
  candidate   MarketIntelligenceCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdAt   DateTime                    @default(now())

  @@index([candidateId])
}

model CompanyEmployee {
  catalogAssignments CompanyCatalogAssignment[]

  id             String                       @id @default(uuid())
  companyId      String
  name           String
  role           String?
  email          String?
  phone          String?
  hourlyRate     Decimal?                     @db.Decimal(12, 2)
  costCenter     String?
  projects       String[]                     @default([])
  employmentType String?
  contractStart  DateTime?
  contractEnd    DateTime?
  vacationTotal  Float?
  vacationTaken  Float?
  active         Boolean                      @default(true)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  certificates   CompanyEmployeeCertificate[]
  documents      CompanyEmployeeDocument[]

  safetyParticipants SafetyInstructionParticipant[]
  safetyPpeRecords   SafetyPpeRecord[]

  @@index([companyId])
  @@index([companyId, name])
}

model CompanyEmployeeCertificate {
  id         String    @id @default(uuid())
  employeeId String
  name       String
  validUntil DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  employee CompanyEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([employeeId, validUntil])
}

model CompanyEmployeeDocument {
  id         String   @id @default(uuid())
  employeeId String
  storageId  String   @unique
  name       String
  mime       String
  size       Int      @default(0)
  createdAt  DateTime @default(now())

  employee CompanyEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  storage  StorageObject   @relation(fields: [storageId], references: [id], onDelete: Cascade)

  @@index([employeeId, createdAt])
}

model CompanyMaterial {
  catalogAssignments CompanyCatalogAssignment[]

  id          String   @id @default(uuid())
  companyId   String
  name        String
  code        String?
  projectId   String?
  costCenter  String?
  location    String?
  unit        String?
  stock       Float    @default(0)
  minStock    Float    @default(0)
  priceNet    Decimal  @default(0) @db.Decimal(12, 2)
  supplier    String?
  attachments Json?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  moves               CompanyMaterialMove[]
  purchaseLines       CompanyPurchaseOrderLine[]
  materialAttachments CompanyMaterialAttachment[]

  @@index([companyId])
  @@index([companyId, projectId])
}

model CompanyMaterialAttachment {
  id         String   @id @default(uuid())
  materialId String
  storageId  String   @unique
  name       String
  mime       String
  size       Int      @default(0)
  createdAt  DateTime @default(now())

  material CompanyMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  storage  StorageObject   @relation(fields: [storageId], references: [id], onDelete: Cascade)

  @@index([materialId, createdAt])
}

model CompanyMaterialMove {
  id         String   @id @default(uuid())
  materialId String
  projectId  String?
  costCenter String?
  date       DateTime @default(now())
  direction  String
  qty        Float
  note       String?

  material CompanyMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([projectId])
}

model CompanyMachine {
  machineUsageEntries MachineUsageEntry[]
  machineReleases MachineRelease[]
  id                  String                      @id @default(uuid())
  companyId           String
  name                String
  type                String?
  serial              String?
  projectId           String?
  costCenter          String?
  location            String?
  status              String?
  hours               Float                       @default(0)
  hourlyRate          Decimal                     @default(0) @db.Decimal(12, 2)
  lastService         DateTime?
  serviceIntervalDays Int                         @default(180)
  nextService         DateTime?
  maintenance         Json?
  attachments         Json?
  active              Boolean                     @default(true)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  maintenanceRecords  CompanyMachineMaintenance[]
  machineAttachments  CompanyMachineAttachment[]

  @@index([companyId])
  @@index([companyId, projectId])
}

model CompanyMachineAttachment {
  id        String   @id @default(uuid())
  machineId String
  storageId String   @unique
  name      String
  mime      String
  size      Int      @default(0)
  createdAt DateTime @default(now())

  machine CompanyMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  storage StorageObject  @relation(fields: [storageId], references: [id], onDelete: Cascade)

  @@index([machineId, createdAt])
}

model ProjectCostCenter {
  id          String   @id @default(uuid())
  companyId   String
  projectId   String
  code        String
  description String
  mainArea    String
  budget      Decimal  @default(0) @db.Decimal(14, 2)
  unit        String?
  note        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, projectId, code])
  @@index([companyId, projectId])
}

model SafetyInstruction {
  id         String    @id @default(uuid())
  companyId  String
  title      String
  projectId  String?
  instructor String?
  date       DateTime?
  nextDate   DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  participants SafetyInstructionParticipant[]
  documents    SafetyInstructionDocument[]

  @@index([companyId])
  @@index([companyId, projectId])
  @@index([companyId, nextDate])
}

model SafetyInstructionParticipant {
  id            String   @id @default(uuid())
  instructionId String
  employeeId    String
  createdAt     DateTime @default(now())

  instruction SafetyInstruction @relation(fields: [instructionId], references: [id], onDelete: Cascade)

  employee CompanyEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([instructionId, employeeId])
  @@index([employeeId])
  @@index([instructionId])
}

model SafetyInstructionDocument {
  id            String   @id @default(uuid())
  instructionId String
  storageId     String   @unique
  name          String
  mime          String
  size          Int      @default(0)
  createdAt     DateTime @default(now())

  instruction SafetyInstruction @relation(fields: [instructionId], references: [id], onDelete: Cascade)

  storage StorageObject @relation(fields: [storageId], references: [id], onDelete: Cascade)

  @@index([instructionId, createdAt])
}

model SafetyRiskAssessment {
  id          String    @id @default(uuid())
  companyId   String
  title       String
  projectId   String?
  activity    String?
  hazard      String?
  riskLevel   String    @default("MEDIUM")
  measures    String?
  responsible String?
  dueDate     DateTime?
  status      String    @default("OPEN")
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId])
  @@index([companyId, projectId])
  @@index([companyId, status])
  @@index([companyId, dueDate])
}

model SafetyInspection {
  id        String    @id @default(uuid())
  companyId String
  title     String
  projectId String?
  date      DateTime?
  inspector String?
  status    String    @default("OPEN")
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  findings SafetyInspectionFinding[]

  @@index([companyId])
  @@index([companyId, projectId])
  @@index([companyId, date])
  @@index([companyId, status])
}

model SafetyInspectionFinding {
  id           String    @id @default(uuid())
  inspectionId String
  title        String
  severity     String    @default("MEDIUM")
  measure      String?
  responsible  String?
  dueDate      DateTime?
  status       String    @default("OPEN")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  inspection SafetyInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@index([inspectionId, status])
}

model SafetyPpeRecord {
  id         String    @id @default(uuid())
  companyId  String
  employeeId String
  type       String
  itemName   String?
  issuedAt   DateTime?
  nextCheck  DateTime?
  condition  String?
  status     String    @default("ACTIVE")
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  employee CompanyEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, employeeId])
  @@index([companyId, nextCheck])
  @@index([companyId, status])
}

model SafetyPermit {
  id          String    @id @default(uuid())
  companyId   String
  title       String
  projectId   String?
  permitType  String
  validFrom   DateTime?
  validUntil  DateTime?
  responsible String?
  status      String    @default("OPEN")
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId])
  @@index([companyId, projectId])
  @@index([companyId, status])
  @@index([companyId, validUntil])
}

model SafetyAttachment {
  id         String   @id @default(uuid())
  companyId  String
  entityType String
  entityId   String
  storageId  String   @unique
  name       String
  mime       String
  size       Int      @default(0)
  createdAt  DateTime @default(now())

  storage StorageObject @relation(fields: [storageId], references: [id], onDelete: Cascade)

  @@index([companyId, entityType, entityId])
  @@index([entityType, entityId, createdAt])
}

model CompanyPurchaseOrder {
  id           String    @id @default(uuid())
  companyId    String
  number       String
  supplier     String?
  projectId    String?
  costCenter   String?
  status       String    @default("ENTWURF")
  orderDate    DateTime?
  deliveryDate DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lines CompanyPurchaseOrderLine[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, projectId])
  @@index([companyId, deliveryDate])
  deliveryReviews DeliveryReview[]

}

model CompanyPurchaseOrderLine {
  id         String   @id @default(uuid())
  orderId    String
  materialId String?
  code       String?
  name       String
  unit       String?
  qty        Float    @default(1)
  priceNet   Decimal  @default(0) @db.Decimal(12, 2)
