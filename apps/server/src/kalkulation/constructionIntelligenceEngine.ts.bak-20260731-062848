/**
 * RLC Construction Intelligence Engine
 *
 * Additive orchestrator for the Kalkulation pipeline.
 * It does not replace existing route logic yet. Every stage is isolated,
 * timed and protected so that one optional intelligence source cannot
 * interrupt the complete calculation.
 */

import { performance } from "node:perf_hooks";
import { calcRecipeKalkulationRow } from "./kalkulationsRecipeEngine";
import {
  resolveRlcAutonomousCalculation,
  mapAutonomousResultToKiRow,
} from "./autonomous/rlcAutonomousKalkulator";
import { resolveRlcKnowledgeHub } from "./knowledgeHub";

export type ConstructionIntelligenceInput = {
  row: Record<string, any>;
  context?: Record<string, any>;
  candidates?: Record<string, any>[];
  companyId?: string;
  projectKey?: string;
};

export type ConstructionStage =
  | "recipe"
  | "autonomous-urkalkulation"
  | "knowledge-hub"
  | "final-selection";

export type ConstructionStageTrace = {
  stage: ConstructionStage;
  ok: boolean;
  durationMs: number;
  source?: string;
  ep?: number;
  message?: string;
};

export type ConstructionIntelligenceResult = {
  ok: boolean;
  result: Record<string, any> | null;
  alternatives: Record<string, any>[];
  trace: ConstructionStageTrace[];
  confidence: number;
  requiresReview: boolean;
  engine: "rlc-construction-intelligence-v1" | "rlc-construction-intelligence-v2";
};

function numeric(value: unknown): number {
  const parsed = Number(value);
  return Number.isFinite(parsed) ? parsed : 0;
}

function text(value: unknown): string {
  return String(value ?? "").trim();
}

function unitPrice(row: Record<string, any> | null | undefined): number {
  if (!row) return 0;
  return numeric(
    row.rlcKiUnitPrice ??
      row.finalUnitPrice ??
      row.suggestedUnitPrice ??
      row.unitPrice ??
      row.ep
  );
}

function sourceOf(row: Record<string, any> | null | undefined): string {
  return text(row?.source || row?.calculationSource || "unknown");
}

function confidenceOf(row: Record<string, any> | null | undefined): number {
  if (!row) return 0;

  const raw = numeric(
    row.confidence ??
      row.calculationConfidence ??
      row.externalKnowledgeConfidence
  );

  if (raw > 1) return Math.max(0, Math.min(1, raw / 100));
  if (raw > 0) return Math.max(0, Math.min(1, raw));

  const source = sourceOf(row).toLowerCase();
  if (source.includes("database")) return 0.86;
  if (source.includes("technical-parser")) return 0.82;
  if (source.includes("recipe")) return 0.78;
  if (source.includes("autonomous")) return 0.72;
  if (source.includes("openai")) return 0.62;
  if (source.includes("rule-engine")) return 0.48;
  return 0.4;
}

function requiresReview(row: Record<string, any> | null | undefined): boolean {
  if (!row) return true;

  const source = sourceOf(row).toLowerCase();
  const warning = text(row.warning || row.warnings || row.aiWarning).toLowerCase();
  const confidence = confidenceOf(row);

  return (
    confidence < 0.7 ||
    source.includes("rule-engine") ||
    source.includes("blocked") ||
    warning.includes("prüfpflicht") ||
    warning.includes("niedrig") ||
    warning.includes("outlier")
  );
}

export type ConstructionCandidateDecision = {
  source: string;
  ep: number;
  confidence: number;
  score: number;
  requiresReview: boolean;
  components: {
    confidence: number;
    sourceQuality: number;
    technicalEvidence: number;
    knowledgeEvidence: number;
    priceBreakdown: number;
    validation: number;
    riskPenalty: number;
    reviewPenalty: number;
  };
  reasons: string[];
};

function candidateLines(row: Record<string, any>): any[] {
  for (const value of [
    row.priceBreakdown,
    row.costLines,
    row.recipeLines,
    row.breakdown,
    row.resources,
  ]) {
    if (Array.isArray(value) && value.length > 0) return value;
  }

  return [];
}

function evaluateCandidate(
  row: Record<string, any>
): ConstructionCandidateDecision {
  const ep = unitPrice(row);
  const source = sourceOf(row);
  const normalizedSource = source.toLowerCase();
  const confidence = confidenceOf(row);
  const review = requiresReview(row);
  const reasons: string[] = [];

  if (ep <= 0) {
    return {
      source,
      ep,
      confidence,
      score: -100,
      requiresReview: true,
      components: {
        confidence: 0,
        sourceQuality: 0,
        technicalEvidence: 0,
        knowledgeEvidence: 0,
        priceBreakdown: 0,
        validation: 0,
        riskPenalty: 0,
        reviewPenalty: -100,
      },
      reasons: ["Kein gültiger Einheitspreis vorhanden."],
    };
  }

  const confidenceScore = confidence * 45;

  let sourceQuality = 5;
  if (normalizedSource.includes("technical-parser")) sourceQuality = 20;
  else if (normalizedSource.includes("database")) sourceQuality = 18;
  else if (normalizedSource.includes("company")) sourceQuality = 18;
  else if (normalizedSource.includes("recipe")) sourceQuality = 16;
  else if (normalizedSource.includes("reverse")) sourceQuality = 14;
  else if (normalizedSource.includes("autonomous")) sourceQuality = 12;
  else if (normalizedSource.includes("openai")) sourceQuality = 8;
  else if (normalizedSource.includes("rule-engine")) sourceQuality = -12;
  else if (normalizedSource.includes("blocked")) sourceQuality = -25;

  reasons.push(
    `Quellenqualität ${Math.round(sourceQuality * 100) / 100} Punkte (${source}).`
  );

  const technicalConfidence = confidenceOf({
    confidence:
      row.technicalConfidence ??
      row.parameters?.technicalConfidence ??
      row.technicalAnalysis?.confidence,
    source: "technical",
  });

  let technicalEvidence = 0;
  if (
    normalizedSource.includes("technical-parser") ||
    technicalConfidence >= 0.8
  ) {
    technicalEvidence = 12;
    reasons.push("Technische Parser-Auswertung mit hoher Belastbarkeit vorhanden.");
  } else if (
    row.technicalBreakdown ||
    row.rlcAgentReports ||
    row.parameters?.technical
  ) {
    technicalEvidence = 7;
    reasons.push("Technische Detailanalyse vorhanden.");
  }

  const knowledgeRows = Array.isArray(row.externalKnowledge)
    ? row.externalKnowledge
    : [];
  const knowledgeConfidence = numeric(row.externalKnowledgeConfidence);

  let knowledgeEvidence = 0;
  if (knowledgeRows.length > 0) {
    knowledgeEvidence = Math.min(
      8,
      3 + knowledgeRows.length + knowledgeConfidence * 3
    );
    reasons.push(
      `${knowledgeRows.length} externe Wissensquelle(n) berücksichtigt.`
    );
  }

  const lines = candidateLines(row);
  let priceBreakdown = 0;
  if (lines.length >= 3) {
    priceBreakdown = 8;
    reasons.push(`Nachvollziehbarer Preisaufbau mit ${lines.length} Kostenzeilen.`);
  } else if (lines.length > 0) {
    priceBreakdown = 4;
    reasons.push("Teilweiser Preisaufbau vorhanden.");
  }

  let validation = 0;
  const validationValid =
    row.rlcAgentSummary?.validationValid ??
    row.validation?.valid ??
    row.validationValid;

  if (validationValid === true) {
    validation = 5;
    reasons.push("Validierungsprüfung erfolgreich.");
  } else if (!review) {
    validation = 3;
  }

  const riskLevel = text(row.riskLevel).toLowerCase();
  let riskPenalty = 0;
  if (riskLevel === "high") {
    riskPenalty = -18;
    reasons.push("Hohes Kalkulationsrisiko.");
  } else if (riskLevel === "medium") {
    riskPenalty = -6;
    reasons.push("Mittleres Kalkulationsrisiko.");
  }

  const reviewPenalty = review ? -8 : 0;
  if (review) reasons.push("Fachliche Prüfung erforderlich.");

  const score =
    confidenceScore +
    sourceQuality +
    technicalEvidence +
    knowledgeEvidence +
    priceBreakdown +
    validation +
    riskPenalty +
    reviewPenalty;

  return {
    source,
    ep,
    confidence,
    score: Math.round(score * 100) / 100,
    requiresReview: review,
    components: {
      confidence: Math.round(confidenceScore * 100) / 100,
      sourceQuality,
      technicalEvidence,
      knowledgeEvidence: Math.round(knowledgeEvidence * 100) / 100,
      priceBreakdown,
      validation,
      riskPenalty,
      reviewPenalty,
    },
    reasons,
  };
}

function scoreCandidate(row: Record<string, any>): number {
  return evaluateCandidate(row).score;
}

async function runStage<T>(
  stage: ConstructionStage,
  trace: ConstructionStageTrace[],
  action: () => Promise<T>
): Promise<T | null> {
  const started = performance.now();

  try {
    const value = await action();
    const candidate = value as any;

    trace.push({
      stage,
      ok: true,
      durationMs: Math.round((performance.now() - started) * 100) / 100,
      source: candidate ? sourceOf(candidate) : undefined,
      ep: candidate ? unitPrice(candidate) : undefined,
    });

    return value;
  } catch (error: any) {
    trace.push({
      stage,
      ok: false,
      durationMs: Math.round((performance.now() - started) * 100) / 100,
      message: text(error?.message || error),
    });

    return null;
  }
}


export type ExistingCalculationTraceInput = {
  startedAtMs?: number;
  stages?: Array<{
    stage: string;
    ok: boolean;
    durationMs?: number;
    message?: string;
  }>;
};

export function annotateExistingCalculation(
  result: Record<string, any> | null | undefined,
  traceInput: ExistingCalculationTraceInput = {}
): Record<string, any> | null {
  if (!result) return null;

  const originalEp = unitPrice(result);
  const originalSource = sourceOf(result);
  const confidence = confidenceOf(result);
  const review = requiresReview(result);
  const totalDurationMs =
    typeof traceInput.startedAtMs === "number"
      ? Math.max(0, Math.round((performance.now() - traceInput.startedAtMs) * 100) / 100)
      : undefined;

  const annotated = {
    ...result,
    constructionIntelligence: {
      engine: "rlc-construction-intelligence-v2",
      mode: "existing-pipeline-observer",
      decisionMode: "existing-result-observation",
      confidence,
      requiresReview: review,
      finalSource: originalSource,
      finalEp: originalEp,
      decisionScore: Math.round(confidence * 10000) / 100,
      decisionReasons: [
        "Bestehendes Kalkulationsergebnis wurde unverändert beobachtet.",
        `Quelle: ${originalSource}.`,
        `Konfidenz: ${Math.round(confidence * 10000) / 100} %.`,
      ],
      decisionComponents: {
        confidence: Math.round(confidence * 10000) / 100,
        sourceQuality: 0,
        technicalEvidence: 0,
        knowledgeEvidence: 0,
        priceBreakdown: 0,
        validation: 0,
        riskPenalty: 0,
        reviewPenalty: review ? -8 : 0,
      },
      alternatives: [],
      totalDurationMs,
      trace: Array.isArray(traceInput.stages) ? traceInput.stages : [],
      priceModified: false,
    },
  };

  if (unitPrice(annotated) !== originalEp || sourceOf(annotated) !== originalSource) {
    throw new Error("Construction Intelligence observer changed EP or source");
  }

  return annotated;
}

export async function runConstructionIntelligence(
  input: ConstructionIntelligenceInput
): Promise<ConstructionIntelligenceResult> {
  const row = input.row || {};
  const trace: ConstructionStageTrace[] = [];
  const alternatives: Record<string, any>[] = [];

  const recipe = await runStage("recipe", trace, async () => {
    return await calcRecipeKalkulationRow(row as any);
  });

  if (recipe && unitPrice(recipe as any) > 0) {
    alternatives.push(recipe as any);
  }

  const autonomous = await runStage(
    "autonomous-urkalkulation",
    trace,
    async () => {
      const resolved = resolveRlcAutonomousCalculation(
        row as any,
        [row as any],
        input.context as any
      );

      return mapAutonomousResultToKiRow(row as any, resolved as any);
    }
  );

  if (autonomous && unitPrice(autonomous as any) > 0) {
    alternatives.push(autonomous as any);
  }

  const knowledge = await runStage("knowledge-hub", trace, async () => {
    return resolveRlcKnowledgeHub({
      kurztext: text(row.kurztext),
      langtext: text(row.langtext),
      einheit: text(row.einheit || row.unit),
      menge: numeric(row.menge ?? row.quantity),
      family: text(
        row.rlcFamily || row.family || row.gewerk || row.leistungsart
      ),
    } as any);
  });

  if ((knowledge as any)?.hasExternalKnowledge) {
    for (const candidate of alternatives) {
      candidate.externalKnowledge = (knowledge as any).externalMatches || [];
      candidate.externalKnowledgeConfidence = numeric(
        (knowledge as any).externalKnowledgeConfidence
      );
      candidate.aiReason = [
        text(candidate.aiReason),
        ...(((knowledge as any).technicalNotes || []) as string[]),
      ]
        .filter(Boolean)
        .join(" ");
    }
  }

  const decisionRanking = alternatives
    .map((candidate) => ({
      candidate,
      decision: evaluateCandidate(candidate),
    }))
    .sort((a, b) => b.decision.score - a.decision.score);

  const finalResult =
    (await runStage("final-selection", trace, async () => {
      return decisionRanking[0]?.candidate || null;
    })) || null;

  const confidence = confidenceOf(finalResult as any);
  const review = requiresReview(finalResult as any);
  const selectedDecision = finalResult
    ? evaluateCandidate(finalResult as any)
    : null;

  if (finalResult) {
    (finalResult as any).constructionIntelligence = {
      engine: "rlc-construction-intelligence-v2",
      decisionMode: "multi-factor-explainable-selection",
      confidence,
      requiresReview: review,
      finalSource: sourceOf(finalResult as any),
      finalEp: unitPrice(finalResult as any),
      decisionScore: selectedDecision?.score || 0,
      decisionReasons: selectedDecision?.reasons || [],
      decisionComponents: selectedDecision?.components || {},
      alternatives: decisionRanking.map(({ decision }, index) => ({
        rank: index + 1,
        source: decision.source,
        ep: decision.ep,
        confidence: decision.confidence,
        score: decision.score,
        requiresReview: decision.requiresReview,
        components: decision.components,
        reasons: decision.reasons,
      })),
      trace,
      priceModified: false,
    };
  }

  return {
    ok: Boolean(finalResult),
    result: finalResult as any,
    alternatives,
    trace,
    confidence,
    requiresReview: review,
    engine: "rlc-construction-intelligence-v2",
  };
}
