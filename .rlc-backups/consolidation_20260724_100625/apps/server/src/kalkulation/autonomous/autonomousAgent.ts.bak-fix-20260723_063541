import fs from "node:fs/promises";
import path from "node:path";

type AutonomousState = "idle" | "running" | "error";

export type AutonomousStatus = {
  enabled: boolean;
  state: AutonomousState;
  startedAt: string | null;
  finishedAt: string | null;
  nextRunAt: string | null;
  projectsRoot: string;
  projectsScanned: number;
  filesScanned: number;
  kalkulationFiles: number;
  aufmassFiles: number;
  workflowFiles: number;
  recentChanges: number;
  lastError: string | null;
  message: string;
};

type AutonomousActivity = {
  at: string;
  level: "info" | "warning" | "error";
  action: string;
  message: string;
  details?: Record<string, unknown>;
};

const PROJECTS_ROOT =
  process.env.PROJECTS_ROOT ||
  process.env.RLC_PROJECTS_ROOT ||
  "/app/data/projects";

const DATA_ROOT =
  process.env.RLC_AUTONOMOUS_DATA_ROOT ||
  "/app/data/autonomous";

const STATUS_FILE = path.join(DATA_ROOT, "status.json");
const ACTIVITY_FILE = path.join(DATA_ROOT, "activities.ndjson");

const INTERVAL_MINUTES = Math.max(
  5,
  Number(process.env.RLC_AUTONOMOUS_INTERVAL_MINUTES || 15)
);

const ENABLED =
  String(process.env.RLC_AUTONOMOUS_ENABLED || "true").toLowerCase() !== "false";

let timer: NodeJS.Timeout | null = null;
let runningPromise: Promise<AutonomousStatus> | null = null;

let status: AutonomousStatus = {
  enabled: ENABLED,
  state: "idle",
  startedAt: null,
  finishedAt: null,
  nextRunAt: null,
  projectsRoot: PROJECTS_ROOT,
  projectsScanned: 0,
  filesScanned: 0,
  kalkulationFiles: 0,
  aufmassFiles: 0,
  workflowFiles: 0,
  recentChanges: 0,
  lastError: null,
  message: ENABLED
    ? "RLC Autonomous Observer bereit."
    : "RLC Autonomous Observer deaktiviert.",
};

function isoNow(): string {
  return new Date().toISOString();
}

async function ensureDataRoot(): Promise<void> {
  await fs.mkdir(DATA_ROOT, { recursive: true });
}

async function writeStatus(): Promise<void> {
  await ensureDataRoot();
  await fs.writeFile(STATUS_FILE, JSON.stringify(status, null, 2), "utf8");
}

async function appendActivity(activity: AutonomousActivity): Promise<void> {
  await ensureDataRoot();
  await fs.appendFile(ACTIVITY_FILE, `${JSON.stringify(activity)}\n`, "utf8");
}

async function walk(
  dir: string,
  counters: {
    filesScanned: number;
    kalkulationFiles: number;
    aufmassFiles: number;
    workflowFiles: number;
    recentChanges: number;
  }
): Promise<void> {
  let entries: Awaited<ReturnType<typeof fs.readdir>>;
  try {
    entries = await fs.readdir(dir, { withFileTypes: true });
  } catch {
    return;
  }

  const recentLimit = Date.now() - 24 * 60 * 60 * 1000;

  for (const entry of entries) {
    if (
      entry.name === "node_modules" ||
      entry.name.startsWith(".") ||
      entry.name.endsWith(".bak")
    ) {
      continue;
    }

    const fullPath = path.join(dir, entry.name);

    if (entry.isDirectory()) {
      await walk(fullPath, counters);
      continue;
    }

    counters.filesScanned += 1;

    const normalized = fullPath.toLowerCase();
    if (normalized.includes("/kalkulation/")) counters.kalkulationFiles += 1;
    if (normalized.includes("aufmass") || normalized.includes("aufma?")) {
      counters.aufmassFiles += 1;
    }
    if (
      normalized.includes("workflow") ||
      normalized.includes("inbox") ||
      normalized.includes("eingang")
    ) {
      counters.workflowFiles += 1;
    }

    try {
      const fileStat = await fs.stat(fullPath);
      if (fileStat.mtimeMs >= recentLimit) counters.recentChanges += 1;
    } catch {
      // Eine einzelne nicht lesbare Datei darf den Lauf nicht abbrechen.
    }
  }
}

async function scanProjects(): Promise<AutonomousStatus> {
  const startedAt = isoNow();

  status = {
    ...status,
    state: "running",
    startedAt,
    lastError: null,
    message: "RLC Autonomous analysiert die Projektablage in sola lettura.",
  };
  await writeStatus();
  await appendActivity({
    at: startedAt,
    level: "info",
    action: "scan-start",
    message: "Autonomous-Projektanalyse gestartet.",
  });

  try {
    let projectEntries: Awaited<ReturnType<typeof fs.readdir>> = [];
    try {
      projectEntries = await fs.readdir(PROJECTS_ROOT, { withFileTypes: true });
    } catch {
      projectEntries = [];
    }

    const projectDirs = projectEntries.filter((entry) => entry.isDirectory());
    const counters = {
      filesScanned: 0,
      kalkulationFiles: 0,
      aufmassFiles: 0,
      workflowFiles: 0,
      recentChanges: 0,
    };

    for (const project of projectDirs) {
      await walk(path.join(PROJECTS_ROOT, project.name), counters);
    }

    const finishedAt = isoNow();
    const nextRunAt = new Date(
      Date.now() + INTERVAL_MINUTES * 60_000
    ).toISOString();

    status = {
      enabled: ENABLED,
      state: "idle",
      startedAt,
      finishedAt,
      nextRunAt,
      projectsRoot: PROJECTS_ROOT,
      projectsScanned: projectDirs.length,
      ...counters,
      lastError: null,
      message:
        `Analyse abgeschlossen: ${projectDirs.length} Projekte, ` +
        `${counters.filesScanned} Dateien, ` +
        `${counters.recentChanges} ?nderungen in den letzten 24 Stunden.`,
    };

    await writeStatus();
    await appendActivity({
      at: finishedAt,
      level: "info",
      action: "scan-finished",
      message: status.message,
      details: {
        projectsScanned: status.projectsScanned,
        filesScanned: status.filesScanned,
        kalkulationFiles: status.kalkulationFiles,
        aufmassFiles: status.aufmassFiles,
        workflowFiles: status.workflowFiles,
        recentChanges: status.recentChanges,
      },
    });

    console.log(`[autonomous] ${status.message}`);
    return status;
  } catch (error: any) {
    const finishedAt = isoNow();
    status = {
      ...status,
      state: "error",
      finishedAt,
      nextRunAt: new Date(
        Date.now() + INTERVAL_MINUTES * 60_000
      ).toISOString(),
      lastError: String(error?.message || error),
      message: "Autonomous-Analyse fehlgeschlagen.",
    };

    await writeStatus();
    await appendActivity({
      at: finishedAt,
      level: "error",
      action: "scan-error",
      message: status.message,
      details: { error: status.lastError },
    });

    console.error("[autonomous]", error);
    return status;
  }
}

export async function runAutonomousAgentNow(): Promise<AutonomousStatus> {
  if (runningPromise) return runningPromise;
  runningPromise = scanProjects().finally(() => {
    runningPromise = null;
  });
  return runningPromise;
}

export function getAutonomousStatus(): AutonomousStatus {
  return { ...status };
}

export async function getAutonomousActivities(
  limit = 100
): Promise<AutonomousActivity[]> {
  try {
    const raw = await fs.readFile(ACTIVITY_FILE, "utf8");
    return raw
      .split(/\r?\n/)
      .filter(Boolean)
      .slice(-Math.max(1, Math.min(limit, 500)))
      .map((line) => JSON.parse(line))
      .reverse();
  } catch {
    return [];
  }
}

export function startAutonomousAgent(): void {
  if (!ENABLED || timer) return;

  void runAutonomousAgentNow();

  timer = setInterval(() => {
    void runAutonomousAgentNow();
  }, INTERVAL_MINUTES * 60_000);

  timer.unref?.();
  console.log(
    `[autonomous] Observer attivo, intervallo ${INTERVAL_MINUTES} minuti.`
  );
}
