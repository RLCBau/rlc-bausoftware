[Unit]
Description=RLC erasure ledger monotonic reference synchronization
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/rlc-bausoftware/infrastructure/backup/sync-erasure-ledger.sh
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/rlc-recovery
ProtectHome=true
