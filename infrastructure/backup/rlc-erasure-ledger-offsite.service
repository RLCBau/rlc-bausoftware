[Unit]
Description=RLC encrypted erasure ledger offsite replication
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/rlc-bausoftware/infrastructure/backup/sync-erasure-ledger-offsite.sh
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
