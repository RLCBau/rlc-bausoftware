[Unit]
Description=RLC remote encrypted backup retention enforcement
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=RLC_REMOTE_RETENTION_DRY_RUN=0
ExecStart=/bin/bash /opt/rlc-bausoftware/infrastructure/backup/expire-remote-backups.sh
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
